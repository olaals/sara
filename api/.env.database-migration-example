# Local EF migrations against the SHARED SARA development database.
# Requires the dev app registration's client secret and database network access.
# Coordinate with the team before applying migrations.
# Assumes sara-dev owns the migration-managed database objects.
#
# dotnet ef does NOT automatically load this file.
# To load it into a dedicated zsh/bash terminal, from the sara repository:
#   cd api
#   set -a
#   source .env.database-migration-example
#   set +a
#
# Do not save an actual secret in this example file.
# Load it separately after az login:
#   export AzureAd__ClientSecret="$(az keyvault secret show \
#     --vault-name saradev-kv --name AzureAd--ClientSecret \
#     --query value --output tsv)"

ASPNETCORE_ENVIRONMENT=Development

Database__RequireAppRegIdentity=true
Database__Server=robotics-dev-psql-server
Database__PostgresDatabase=sara
Database__User=sara-dev

AzureAd__TenantId=3aa4a235-b6e2-48d5-9195-7fcf05b459b0
AzureAd__ClientId=dd7e115a-037e-4846-99c4-07561158a9cd

# Override all configured array indices to prevent personal CLI authentication.
AzureAd__AllowedAuthMethods__0=ClientSecret
AzureAd__AllowedAuthMethods__1=ClientSecret
AzureAd__AllowedAuthMethods__2=ClientSecret

# Read migration state without applying changes:
#   dotnet ef migrations list --context SaraDbContext
#
# Apply pending migrations up to a reviewed target:
#   dotnet ef database update <TargetMigrationNameOrId> --context SaraDbContext
#
# Selecting a target older than the current database state requests a rollback.
# Close this dedicated terminal after use to discard credentials and settings.
