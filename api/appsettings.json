{
  "AppName": "sara-backend",
  "AzureAd": {
    "TenantId": "3aa4a235-b6e2-48d5-9195-7fcf05b459b0",
    "Instance": "https://login.microsoftonline.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.IdentityModel": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://*.equinor.com/"
  ],
  "Database": {
    "AllowedAuthMethods": [ "ConnectionString" ],
    "postgresConnectionString": "",
    "Server": "",
    "PostgresDatabase": "",
    "User": "",
    "Timeout": 30
  },
  "KeyVault": {
    "UseKeyVault": true
  },
  "ApiBaseRoute": "",
  "FlotillaBaseUrl": "",
  "ArgoWorkflowsBaseUrl": "",
  "ArgoWorkflowsNamespace": "",
  "Frontend": {
    "Enabled": true
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "Username": "sara",
    "Topics": [
      "isar/+/inspection_result",
      "isar/+/inspection_value"
    ],
    "MaxRetryAttempts": 5,
    "ShouldFailOnMaxRetries": false,
    "AllowInsecureLocalConnections": false
  },
  "Analysis": {
    "DefaultAnalysisByInspectionType": {
      "Image": ["Anonymize"],
      "ThermalImage": ["Anonymize"]
    },
    "DefaultAnalysisByInspectionTypeAndExtension": {
      "Video": { ".mp4": ["Passthrough"] },
      "ThermalVideo": { ".mp4": ["Passthrough"] },
      "AcousticMeasurement": { ".mp4": ["AnonymizeAcoustic"] }
    },
    "AnalysisGroupTimeoutMinutes": 30
  },
  "SARATimeseriesBaseUrl": "http://sara-timeseries:8200",
  "Storage": {
    "RawStorageAccount": "",
    "AnonStorageAccount": "",
    "VisStorageAccount": "",
    "ThermalReferenceStorageAccount": ""
  },
  "Email": {
    "Fencilla": {
      "Installations": {}
    }
  },
  "Benchmarks": {
    "StorageAccount": "saradatasets",
    "Definitions": [
      {
        "Id": "anonymizer",
        "Label": "Anonymizer",
        "Description": "Evaluates face and person anonymization models across segmentation and bounding-box methods.",
        "Container": "anonymizer",
        "WorkflowTemplate": "anonymizer-benchmark",
        "DefaultSplit": "val",
        "Devices": [ "cpu", "gpu" ],
        "Methods": [ "segmentation", "bounding_box" ],
        "Parameters": [
          {
            "Name": "confidence-threshold",
            "Label": "Confidence",
            "Min": 0.0,
            "MinExclusive": true,
            "Max": 1.0,
            "Step": 0.05,
            "Placeholder": "0.3",
            "OnlyForMethods": [ "bounding_box" ]
          },
          {
            "Name": "box-padding",
            "Label": "Box padding",
            "Min": 0.0,
            "Max": 1.0,
            "Step": 0.05,
            "Placeholder": "0.1",
            "OnlyForMethods": [ "bounding_box" ]
          }
        ]
      },
      {
        "Id": "rain-drop-detection",
        "Label": "Rain Drop Detector",
        "Description": "Evaluates raindrop detection models on camera lens images.",
        "Container": "rain-drop-detection",
        "WorkflowTemplate": "rain-drop-detector-benchmark",
        "DefaultSplit": "val",
        "Devices": [ "cpu" ],
        "Parameters": [
          {
            "Name": "confidence-threshold",
            "Label": "Confidence",
            "Min": 0.0,
            "MinExclusive": true,
            "Max": 1.0,
            "Step": 0.05,
            "Placeholder": "0.25"
          }
        ]
      },
      {
        "Id": "thermal-reading",
        "Label": "Thermal Reading",
        "Description": "Evaluates thermal image alignment and polygon P95 temperature extraction against ground-truth regions.",
        "Container": "thermal-reading",
        "WorkflowTemplate": "thermal-reading-benchmark",
        "DefaultSplit": "val",
        "Devices": [ "cpu" ],
        "Methods": [ "phase_correlation", "orb_bf" ],
        "Parameters": [
          {
            "Name": "confidence-threshold",
            "Label": "Confidence",
            "Min": 0.0,
            "Max": 1.0,
            "Step": 0.05,
            "Placeholder": "0.5"
          },
          {
            "Name": "iou-threshold",
            "Label": "Min IoU",
            "Min": 0.0,
            "MinExclusive": true,
            "Max": 1.0,
            "Step": 0.05,
            "Placeholder": "0.7"
          }
        ]
      }
    ]
  }
}
